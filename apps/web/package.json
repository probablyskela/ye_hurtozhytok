{
  "name": "@ehurtozhytok/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "npm run typegen && tsc -b",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ehurtozhytok --local",
    "db:migrate:remote": "wrangler d1 migrations apply ehurtozhytok --remote",
    "role:grant": "tsx scripts/role-grant.ts",
    "vapid:keys": "tsx scripts/vapid-keys.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.15.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.1.17",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
