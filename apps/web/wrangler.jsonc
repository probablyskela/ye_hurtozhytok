{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ehurtozhytok",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "vars": {
    // Used for the Google sign-in redirect and in reminders sent from cron.
    "APP_URL": "https://ehurtozhytok.pages.dev",
    // Public half of the Web Push key pair; the private half is a secret.
    "VAPID_PUBLIC_KEY": "BINn6_eWph5C_iIMcWD06U5O5b-P_92HXa7I5LlBYFfgSfl2yXQaAmKpUO7GDxzWWtikvNnMa_npyubrhRR1kyE",
    "VAPID_SUBJECT": "https://ehurtozhytok.pages.dev",
  },
  // Every minute: reminders 15 minutes before a booking starts, then the next
  // batch of queued push messages (important announcements).
  "triggers": {
    "crons": ["* * * * *"],
  },
  // Public address is https://ehurtozhytok.pages.dev (apps/gateway forwards to this Worker).
  "workers_dev": false,
  "preview_urls": false,
  // Pictures of announcements; served by the Worker with a permission check,
  // never from a public bucket. Create it once: npx wrangler r2 bucket create ehurtozhytok-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ehurtozhytok-media",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ehurtozhytok",
      "database_id": "6058d1d9-3fc5-43bc-b435-3a320f72ac97",
      "migrations_dir": "../../infra/d1/migrations",
    },
  ],
}
