{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@ehurtozhytok/web",
        "--",
        "--port",
        "5180",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
      "port": 5180
    },
    {
      "name": "mockup",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5190",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design/mockup"
      ],
      "port": 5190
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5191",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design/prototype"
      ],
      "port": 5191
    }
  ]
}
